<div class="d-flex align-items-center justify-content-between">
  <div>
    <h2>Favourites</h2>
    <p>
      Here are your favourite shows.
    </p>
  </div>
</div>

<hr />

<% if @shows.any? %>
  <%= render @shows, watched_state: true %>
  <%= paginate @shows %>
<% else %>
  <div class="text-center bg-light my-5 py-5">
    <h2>Oh no!</h2>
    <p>You don't have any favourites.</p>
  </div>
<% end %>
