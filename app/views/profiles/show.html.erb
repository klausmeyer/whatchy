<h2>Profile</h2>

<p><%= @user.email %></p>

<p><%= link_to 'Change E-Mail or Password', edit_user_registration_path %></p>

<h3>Linked OIDC Accounts</h3>

<ul>
  <% @user.oidc_identities.each do |identity| %>
    <li><%= identity.email || identity.uid %> via <%= identity.issuer %></li>
  <% end %>
</ul>
